# Browser OAuth Client ID. Authorize http://localhost:8081 as a JavaScript origin.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Native OAuth client IDs only for development/native builds (not Expo Go).
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Mandatory for optional backend profile. Generate a long random value.
API_KEY=
